{
  "name": "mangistore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "mangistore_backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w mangistore_backend",
    "dev": "npm run dev:backend",
    "dev:all": "npm run dev -w mangistore_backend & npm run dev -w frontend",
    "start": "npm run start -w mangistore_backend",
    "build": "npm run build -w frontend",
    "build:frontend": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && npm run lint -w mangistore_backend"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
